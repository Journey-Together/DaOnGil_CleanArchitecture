<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/item_walkthrough_emergency_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_semibold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:text="위급 상황에도 안심하고\n여행할 수 있도록 도와드려요"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_big1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_walkthrough_emergency_title2_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small2"
        android:fontFamily="@font/pretendard_regular"
        android:gravity="center"
        android:text="응급실, 심장제세동기, 약국을\n지도로 한눈에 확인할 수 있어요"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/font_small1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_walkthrough_emergency_title_tv" />

    <ImageView
        android:id="@+id/item_walkthrough_emergency_iv"
        android:layout_width="wrap_content"
        android:layout_height="300dp"
        android:layout_marginTop="14dp"
        android:src="@drawable/image_walkthrough_emergency"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_walkthrough_emergency_title2_tv" />

</androidx.constraintlayout.widget.ConstraintLayout>