<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/item_walkthrough_setting_theme_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_semibold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:text="@string/walkthrough_setting_theme_title_tv"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_big1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_walkthrough_setting_theme_title2_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small2"
        android:fontFamily="@font/pretendard_regular"
        android:gravity="center"
        android:text="@string/walkthrough_setting_theme_message_tv"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/font_small1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_walkthrough_setting_theme_title_tv" />

    <ImageView
        android:id="@+id/item_walkthrough_setting_theme_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:src="@drawable/image_theme_temp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_walkthrough_setting_theme_title2_tv" />

</androidx.constraintlayout.widget.ConstraintLayout>